      {
        "key": "uzh-7-31-r1:c4",
        "title": "Xorazm yurishlari boshlanishi",
        "body": "Kitob Xorazmga harbiy yurishlar 1372-yildan boshlanganini qayd etadi. Boshlanish sanasi oxirgi bo‘ysundirish sanasining o‘zi emas.",
        "fact_ids": [
          "uzh-7-topic-31:khorezmstart"
