      {
        "key": "uzh-11-22-r1:c1",
        "title": "MDHning shakllanishi",
        "body": "1991-yil dekabrda Mustaqil Davlatlar Hamdo‘stligini tuzish kelishuvlari bo‘lgan. 21-dekabr Almati uchrashuvida O‘zbekiston ham qatnashgan. Dastlabki kelishuv va boshqa davlatlarning qo‘shilish bosqichi ajratiladi.",
        "fact_ids": [
          "uzh-11-topic-22:cis"
        ],
