      {
        "key": "uzh-7-32-r1:c3",
        "title": "Askar to‘plash mansabi",
        "body": "Viloyatlardan askar to‘plash bilan tavochi mansabidagi amaldorlar shug‘ullangani ko‘rsatiladi. Mansabni yuzlik yoki minglik birligining o‘zi bilan almashtirmang.",
        "fact_ids": [
