  "title": "Ijtimoiy-iqtisodiy o‘zgarishlar",
  "content": {
    "cards": [
      {
        "key": "uzh-7-1-r1:c1",
        "title": "Sug‘orish va hosil",
        "body": "Darslik ilk o‘rta asrlardagi kanallar va suv chiqarish vositalarini sug‘orma dehqonchilik maydonlarining kengayishi bilan bog‘laydi. Suv ta’minoti ekin yetishtirishda muhim bo‘lgan.",
        "fact_ids": [
          "uzh-7-topic-1:irrigation"
        ],
        "source_refs": [
