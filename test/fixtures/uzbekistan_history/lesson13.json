      {
        "key": "uzh-7-13-r1:c3",
        "title": "Taroz yurishi",
        "body": "Manbada Ismoilning Tarozni 893-yili egallagani ko‘rsatiladi. Bu harbiy yurish 888-yilgi birlashuv qaydidan keyin kelgan.",
        "fact_ids": [
