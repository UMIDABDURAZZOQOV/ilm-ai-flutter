  "title": "G‘arbiy turk xoqonligi",
  "content": {
    "cards": [
      {
        "key": "uzh-7-5-r1:c1",
        "title": "To‘ng yabg‘u davri",
        "body": "Darslik To‘ng yabg‘u hukmronligini 618–630-yillar bilan bog‘laydi. Matnda uning boshqaruv tartibidagi islohotlari va mahalliy hokimlar bilan munosabatlari ko‘rsatiladi.",
        "fact_ids": [
          "uzh-7-topic-5:tong"
        ],
        "source_refs": [
