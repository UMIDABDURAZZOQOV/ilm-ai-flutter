          }
        ]
      },
      {
        "key": "uzh-7-6-r1:c4",
        "title": "Choch va Eloqni ajratamiz",
        "body": "Choch va Eloq Chirchiq va Ohangaron vodiylariga bog‘langan ikki hokimlik. Kitob Eloq markazini Tunkat deb ataydi. Bu nomni Choch hokimligining nomi bilan almashtirmang.",
        "fact_ids": [
          "uzh-7-topic-6:valleys"
        ],
        "source_refs": [
