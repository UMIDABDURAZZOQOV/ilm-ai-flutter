      {
        "key": "uzh-7-6-r1:c7",
        "title": "Ichki qism",
        "body": "Shahriston darslikda shaharning ichki qismi deb izohlangan. Uni tashqi mavze bilan tenglashtirmang.",
        "fact_ids": [
          "uzh-7-topic-6:shahriston"
