      {
        "key": "uzh-7-6-r1:c2",
        "title": "Sug‘d vohalari",
        "body": "Kitob Sug‘d ittifoqini Zarafshon va Qashqadaryo vodiylaridagi Samarqand, Buxoro va Kesh vohalari bilan bog‘laydi. Mahalliy mulklarning o‘z hokimi, chokari va mis puli bo‘lgan.",
        "fact_ids": [
          "uzh-7-topic-6:sogd"
        ],
        "source_refs": [
          {
